{
  "mcpServers": {
    "somnia-liquidation-keeper-ai": {
      "command": "cargo",
      "args": [
        "run",
        "--release",
        "--quiet"
      ],
      "env": {
        "RUST_LOG": "info",
        "HACKATHON_TRACK": "Somnia Network",
        "PROJECT_TICKER": "SOMLIQ"
      },
      "tools": [
        {
          "name": "verify_somliq_invariants",
          "description": "Verifies deterministic invariants for Somnia Liquidation Keeper AI on Somnia Network."
        },
        {
          "name": "execute_somliq_action",
          "description": "Executes authenticated DeFi state transition."
        }
      ]
    }
  }
}